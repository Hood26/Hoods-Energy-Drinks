{
  // All values can be changed and will be reflected in game on server restart
  // Mostly true or false values, but some are integer values

  "config": {
    // energy drink will be enabled in the game if true
    "monster_blue_enable": true,
    // energy drink will have skill effect buffs on consumption if true. skill effect buffs can be configured in buffs.ts
    "monster_blue_effect_toggle": true,
    // energy drink will be sold by Therapist if true
    "monster_blue_sold_by_trader": true,
    // item will be banned from the fleamarket and can only be found in-raid or trader if applicable
    "monster_blue_flea_banned": false,
    // price from Therapist
    "monster_blue_trader_price": 25000,
    // price on the flea market
    "monster_blue_flea_price": 35000,
    // handbook price used to determine how much money is recieved if energy drink is sold to a trader
    "monster_blue_handbook_price": 30000,
    // amount sold by Therapist
    "monster_blue_stock": 1,
    // loyalty level required to purchase from Therapist
    "monster_blue_loyalty_level": 1,
    // weighted chance for energy drink to spawn in duffle bags, lower = more rare, higher = more common
    "monster_blue_loot_duffle_bag_weight": 200,
    // weighted chance for energy drink to spawn in dead scavs, lower = more rare, higher = more common
    "monster_blue_loot_dead_scav_weight": 200,
    // weighted chance for energy drink to spawn in jackets, lower = more rare, higher = more common
    "monster_blue_loot_jacket_weight": 200,
    // weighted chance for energy drink to spawn in ration supply crates, lower = more rare, higher = more common
    "monster_blue_loot_ration_supply_crate_weight": 200,
    // weighted chance for energy drink to spawn in ground caches, lower = more rare, higher = more common
    "monster_blue_loot_ground_cache_weight": 150,
    // 0.3 multiplied by max energy drink spawn chance = custom energy drink spawn chance in loose loot around the map 
    "monster_blue_loose_loot_multiplier": 0.3,

